{
  "name": "studentos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "StudentOS with a MongoDB API, private environment configuration, and optional Firebase setup.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0 --port 5500",
    "dev:api": "node --env-file-if-exists=.env backend/dev.mjs",
    "start": "node --env-file-if-exists=.env backend/index.mjs",
    "go-live": "npm run build && node --env-file-if-exists=.env backend/index.mjs",
    "test:attendance": "node --test tests/attendanceThreshold.test.mjs",
    "test:attendance-closures": "node --test tests/attendanceClosures.test.mjs",
    "test:calendar": "node --test tests/calendarActivity.test.mjs",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 0.0.0.0 --port 5500",
    "test": "node --test tests/*.test.mjs",
    "check:repository": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.469.0",
    "mongodb": "^6.21.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "write-excel-file": "^4.1.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
